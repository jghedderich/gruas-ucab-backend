{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    // Aqui van las rutas de los microservicios, lo dejare como un ejemplo de el curso y del microservicio de usuarios mientras
    "Routes": [
      {
        "route1": {
          "ClusterId": "cluster1",
          "Match": {
            "Path": "{**cath-all}"
          }
        }
      },
      {
        "RouteId": "user_microservice_route",
        "ClusterId": "user_microservice_cluster",
        "Match": {
          "Path": "/users/{**catch-all}"
        }
      }
    ],
    "Clusters": {
      "cluster1": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:6000/products"
          }
        }
      },
      "user_microservice_cluster": {
        "Destinations": {
          "user_microservice_destination": {
            "Address": "http://localhost:6000/users"
          }
        }
      }
    }
  }
}
